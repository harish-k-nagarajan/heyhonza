# Copy to Vercel Environment Variables (never commit real secrets).
# For local dev, copy the values into a .env.local file (gitignored).

# --- LLM (conversation engine) ---
# Gateway is OpenRouter (Phase 3). Get a key at https://openrouter.ai/keys.
# The conversation engine (src/lib/server/conversation-engine.ts) is the only
# place that talks to it. OPENAI_API_KEY is no longer used.
OPENROUTER_API_KEY=
# Optional default model when the client omits or sends an unknown model.
# Must be an OpenRouter model slug (allowlist in src/lib/constants.ts).
HONZA_DEFAULT_MODEL=openai/gpt-4o-mini
# Optional: used for OpenRouter attribution headers.
NEXT_PUBLIC_SITE_URL=

# --- Voice / TTS (Phase 8) ---
# Honza's spoken replies. Server-only: src/lib/server/tts.ts is the only place
# that reads these, and the browser only ever receives audio bytes from
# /api/tts. Never prefix with NEXT_PUBLIC_. Key: elevenlabs.io → Profile → API Keys.
ELEVENLABS_API_KEY=
# Optional. Defaults to a premade voice that works on the free tier.
# NOTE: ElevenLabs' free tier cannot use library ("professional") voices via the
# API — those 402 even though the dashboard lists them. If this points at one,
# the server falls back to the premade default and logs a warning. Czech-native
# voices are library voices, so a paid plan is what unlocks a real Czech accent.
ELEVENLABS_VOICE_ID=

# --- Auth + database (Supabase, Phase 1) ---
# Project URL + anon key are public-safe (Row Level Security protects data).
# Find them in Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Web Push (foundation — optional until VAPID keys + cron are provisioned).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Local dev only — powers scripts/dev-signin.mjs, which mints a sign-in token via
# the admin API instead of burning one of the built-in mailer's ~2 emails/hour.
# Bypasses RLS: keep it out of Vercel's client-exposed vars and out of src/.
SUPABASE_SERVICE_ROLE_KEY=
